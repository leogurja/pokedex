generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entries {
  id Int
  name String
  genus String
  isBaby Boolean
  isLegendary Boolean
  isMythical Boolean
  order Int

  @@index([name], map: "index_pokemon_name")
  @@id([id, name])
}
